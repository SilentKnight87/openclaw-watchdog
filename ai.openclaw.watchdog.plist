<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.openclaw.watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__WATCHDOG_SCRIPT__</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>StandardOutPath</key>
  <string>__WATCHDOG_STDOUT__</string>

  <key>StandardErrorPath</key>
  <string>__WATCHDOG_STDERR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__WATCHDOG_PATH__</string>
    <key>WATCHDOG_CHAT_ID</key>
    <string>__WATCHDOG_CHAT_ID__</string>
  </dict>
</dict>
</plist>
